# Copy this file to .env.local and paste your key after the = sign.
# .env.local is ignored by git, and the key is only read by the small local
# server (npm run dev / npm start). It is never sent to the browser.
ANTHROPIC_API_KEY=

# Most new pages Claude may write per day (each call is roughly a tenth of a cent).
OLDWEB_DAILY_CAP=150
